  "typography": {
    "families": {
      "ui": "'Archivo', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Noto Sans SC', sans-serif",
      "figures": "'Bitter', ui-serif, 'Songti SC', 'Noto Serif SC', Georgia, serif"
    },
    "scale": {
      "day": { "size": "52px", "lineHeight": 0.86, "weight": 600, "tracking": "-0.045em", "family": "figures" },
      "display": { "size": "30px", "lineHeight": 1.06, "weight": 600, "family": "figures" },
      "title": { "size": "22px", "lineHeight": 1.1, "weight": 600, "tracking": "-0.02em" },
      "lead": { "size": "17px", "lineHeight": 1.5, "weight": 400 },
      "body": { "size": "15px", "lineHeight": 1.5, "weight": 400 },
      "meta": { "size": "12.5px", "lineHeight": 1.45, "weight": 400 },
      "label": { "size": "10.5px", "lineHeight": 1.3, "weight": 600, "tracking": "0.14em" }
    }
  },
  "spacing": {
    "base": "4px",
    "pagePad": { "mobile": "20px", "desktop": "28px" },
    "maxWidth": "560px",
    "sectionGap": "28px",
    "rowHeight": "48-56px"
  },
  "radius": { "control": "2px", "panel": "2px", "sheet": "2px", "cell": "1px" },
  "stocks": {
    "mastheadRule": "2px solid ink",
    "todayMark": "2px x 40px red segment on the masthead rule",
    "divider": "1px solid rule",
    "shadow": "sheets and dialogs only"
  },
  "components": [
    { "name": "nav-tab", "usage": "bottom navigation, text only, red mark under the current tab" },
    { "name": "label", "usage": "section heading and micro label, tracked, ink-3" },
    { "name": "ledger", "usage": "list surface: hairline between rows, no card" },
    { "name": "check", "usage": "19px square checkbox, ink fill when checked, tick draws" },
    { "name": "SegmentedTabs", "usage": "underline tabs with a sliding red indicator" },
    { "name": "btn-primary", "usage": "ink block button, hover turns red" },
    { "name": "btn-ghost", "usage": "1px bordered quiet button" },
    { "name": "field", "usage": "bottom-rule form input, red caret" },
    { "name": "switch", "usage": "36x20 square-cornered toggle" },
    { "name": "fig", "usage": "Bitter tabular figures for dates, amounts, counts" },
    { "name": "stamp", "usage": "44px square add action" }
  ],
  "motion": {
    "tick": "260ms stroke draw on check",
    "pageIn": "260ms translateY(6px)",
    "sheet": "300ms translateY(32px)",
    "dialog": "200ms fade + 8px",
    "reducedMotion": "all durations 0.01ms"
  },
  "rules": [
    "no cards, no nested cards",
    "no pill radii",
    "no gradients or glass",
    "no decorative shadows",
    "red only marks: today, overdue, current position, destructive",
    "monospace only for code, JSON and time values",
    "body and secondary text contrast >= 4.5:1"
  ]
}
